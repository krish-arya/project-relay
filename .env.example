# Copy to .env to override. Every value here is a safe local default; none is a secret.

# --- Database -------------------------------------------------------------
# Host port for the compose Postgres (5433 avoids clashing with a local Postgres on 5432).
RELAY_PG_PORT=5433
POSTGRES_PASSWORD=relay
# Superuser DSN: used only for migrations and test setup.
DATABASE_ADMIN_URL=postgresql://postgres:relay@localhost:5433/relay
# Application DSN: non-superuser role, subject to FORCE ROW LEVEL SECURITY.
DATABASE_URL=postgresql://relay_app:relay_app@localhost:5433/relay
# Password given to the relay_app role by the migrations.
RELAY_APP_PASSWORD=relay_app

# --- Models (Ollama, local, free) -----------------------------------------
OLLAMA_URL=http://localhost:11434
# "ollama" for real runs, "fake" for the deterministic offline model used by tests.
MODEL_PROVIDER=ollama
MODEL_TRIAGE=qwen2.5:1.5b
MODEL_DRAFT=qwen2.5:3b
MODEL_EMBED=nomic-embed-text
# Fallbacks used when the circuit breaker for the primary model is open.
MODEL_TRIAGE_FALLBACK=qwen2.5:3b
MODEL_DRAFT_FALLBACK=qwen2.5:1.5b
MODEL_TEMPERATURE=0
MODEL_SEED=7
MODEL_TIMEOUT_S=120

# --- Budgets (tokens in + tokens out) --------------------------------------
TOKEN_BUDGET_TICKET=8000
TOKEN_BUDGET_RUN=400000

# --- Queue ----------------------------------------------------------------
QUEUE_LEASE_S=300
QUEUE_MAX_ATTEMPTS=4
QUEUE_BACKOFF_BASE_S=2
QUEUE_BACKOFF_MAX_S=60

# --- Reliability ----------------------------------------------------------
# Fraction of model calls the gateway fails on purpose (0 = off). Try 0.3.
CHAOS_FAIL_RATE=0
BREAKER_FAILURE_THRESHOLD=3
BREAKER_COOLDOWN_S=30

# --- Retrieval ------------------------------------------------------------
RETRIEVAL_TOP_K=3
# Passages below this cosine similarity are not treated as covering the request.
RETRIEVAL_MIN_SCORE=0.55
# When the best KB match beats the runner-up by at least this much, its category
# (data/<tenant>/policy.json kb_categories) overrides the triage model's category.
RETRIEVAL_CATEGORY_MARGIN=0.04

# --- Operator -------------------------------------------------------------
# Name recorded as approved_by / actor when --by is not given.
RELAY_OPERATOR=operator
